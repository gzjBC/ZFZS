# 复制为 .env.local 并填写（.env.local 已被 gitignore，不会提交）

# AI 推荐（二选一，千问优先）：
# 千问 API Key：阿里云百炼 platform 申请（bailian.console.aliyun.com），仅存本地
DASHSCOPE_API_KEY=
# 千问模型名（默认 qwen-flash 最便宜档；可改 qwen-plus / qwen-max 等）
QWEN_MODEL=qwen-flash

# DeepSeek API Key：platform.deepseek.com 申请（千问不可用时兜底）
DEEPSEEK_API_KEY=
# DeepSeek 模型名（默认 deepseek-v4-flash 最便宜档）
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 PostgreSQL（与 docker-compose.yml 一致）
DATABASE_URL=postgres://anime:anime@localhost:5432/anime_tracker

# 调用 Bangumi API 时携带的 User-Agent（Bangumi 官方要求标识应用）
BANGUMI_USER_AGENT=anime-tracker/0.1 (local dev)

# 访问 Bangumi 需要代理时填写（梯子/公司代理的本地地址，如 Clash 7890）
# 不填则直连
HTTPS_PROXY=http://127.0.0.1:7892
